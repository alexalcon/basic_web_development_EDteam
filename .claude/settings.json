{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions:": {
		"deny": [
			"Read(./.env)",
			"Read(./config.json)",
			"Read(./bin)",
			"Read(./*.exe)",

			"Bash(cat ./.*)",
			"Bash(less ./.*)",
			"Bash(head ./.*)",
			"Bash(tail ./.*)",
			"Bash(grep ./.*)",
			"Bash(diff ./.*)",

			"Bash(sudo *)",
			"Bash(chmod *)",
			"Bash(npm *)",
			"Bash(node *)",
			"Bash(npx *)",
			"Bash(rm -rf *)",
			
			"Bash(git push --force*)",
			"Bash(git push -f *)",
			"Bash(git reset --hard*)",
			"Bash(git clean -f*)"
		]
	}
}